# Copy this file to .env.local-scanner and fill in your real values.

# Your machine's real LAN IP (the one your phone can reach on the same WiFi).
# Find it with `ipconfig` (Windows) or `ip addr` (Linux/macOS).
CONQR_IP=192.168.1.42
CONQR_PORT=8080

# Optional: same Apps Script webhook used elsewhere, so local check-ins also
# update the Google Sheet's "Checked In" / "Checked In At" columns.
# SHEET_CHECKIN_URL=https://script.google.com/macros/s/your-deployment-id/exec
# SHEET_CHECKIN_SECRET=change-me
