FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY assets ./assets
COPY CHANGELOG.txt LICENSE.txt README.md ./
RUN mkdir -p /app/database

VOLUME ["/app/database"]

# HTTP check-in server (port 8080 by default, see CONQR_PORT).
EXPOSE 8080

# CONQR_IP must be set to the host machine's real LAN IP (e.g. 192.168.1.42)
# so phones on the same WiFi can reach it. Pass it in with -e CONQR_IP=... or
# via an .env file (see docker-compose.local-scanner.yml).
CMD ["python3", "src/conqr.py", "4"]
